{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnatomicalAnnotation",
  "type": "object",
  "required": [
    "schema_version",
    "annotation_id",
    "type",
    "structure_id",
    "mesh_hash",
    "surface_anchor",
    "global_position",
    "transform_version",
    "side",
    "author",
    "source_claim_ids",
    "review_status",
    "uncertainty_mm",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "annotation_id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["ACUPOINT", "LANDMARK", "NOTE", "PATH_WAYPOINT"]
    },
    "name": { "type": "string" },
    "code": { "type": "string" },
    "structure_id": { "type": "string" },
    "mesh_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "surface_anchor": {
      "type": "object",
      "required": ["method", "local_position"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["barycentric", "vertex_index", "local_coordinates", "parent_bone"]
        },
        "triangle_id": { "type": ["integer", "null"] },
        "vertex_index": { "type": ["integer", "null"] },
        "barycentric_coords": {
          "type": ["array", "null"],
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "local_position": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "normal": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "additionalProperties": false
    },
    "global_position": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "transform_version": { "type": "string" },
    "side": {
      "type": "string",
      "enum": ["LEFT", "RIGHT", "MIDLINE", "BILATERAL", "UNKNOWN"]
    },
    "author": { "type": "string" },
    "source_claim_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "USER_ANNOTATED_UNVERIFIED",
        "EXPERT_REVIEW_PENDING",
        "CONTESTED",
        "REVIEWED_NOT_CLINICAL"
      ]
    },
    "uncertainty_mm": { "type": "number", "minimum": 0.0 },
    "notes": { "type": "string" },
    "created_at": { "type": "string" }
  },
  "additionalProperties": false
}
