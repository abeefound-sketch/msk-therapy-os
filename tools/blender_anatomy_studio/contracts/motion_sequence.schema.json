{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MotionSequence",
  "type": "object",
  "required": [
    "schema_version",
    "motion_id",
    "source_trial",
    "source_type",
    "fps",
    "root_transform",
    "rig_version",
    "source_skeleton",
    "target_skeleton",
    "frames",
    "quality_metadata"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "motion_id": { "type": "string" },
    "source_trial": { "type": "string" },
    "source_type": {
      "type": "string",
      "enum": ["CMU_MOCAP", "OPENSIM_MOT", "SYNTHETIC_NUMERICAL", "MEDIAPIPE_ESTIMATED"]
    },
    "fps": { "type": "number", "minimum": 1.0 },
    "root_transform": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 16,
      "maxItems": 16
    },
    "rig_version": { "type": "string" },
    "source_skeleton": { "type": "string" },
    "target_skeleton": { "type": "string" },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame_index", "time_seconds", "joint_rotations", "confidence"],
        "properties": {
          "frame_index": { "type": "integer" },
          "time_seconds": { "type": "number" },
          "joint_rotations": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "observable_flags": {
            "type": "object",
            "additionalProperties": { "type": "boolean" }
          }
        },
        "additionalProperties": false
      }
    },
    "quality_metadata": {
      "type": "object",
      "required": ["total_frames", "dropped_frames", "unobservable_dofs", "checksum"],
      "properties": {
        "total_frames": { "type": "integer" },
        "dropped_frames": { "type": "integer" },
        "unobservable_dofs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "checksum": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
