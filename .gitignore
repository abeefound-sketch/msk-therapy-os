# OS / editor metadata
.DS_Store
Thumbs.db
*.swp
*.tmp
*~

# Python cache & virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Node / web dependencies
node_modules/
dist/
build/

# Secrets & credentials (TUYỆT ĐỐI không commit secrets)
.env
.env.*
*.key
*.pem
*secret*
*token*
*.backup_hmac_key
2data/.backup_hmac_key
*.backup_hmac_keys_history
2data/.backup_hmac_keys_history

# Ephemeral runtime & test artifacts
demo.sqlite3*
2data/backups/*test*
2data/backups/*snap*
2data/backups/*tmp*
2data/backups/api_test_backup*
2data/backups/demo_governance_backup*

# Upstream research workspaces
research/upstream/
research/upstream/*
!research/upstream/.gitkeep
3refs/upstream/
3refs/upstream/*
!3refs/upstream/.gitkeep

# Lưu ý theo PROJECT_STRUCTURE_CANON & GIT_REPO_CANON:
# Những thành phần sau BẮT BUỘC backup, KHÔNG đưa vào .gitignore:
# - .m/ (build journal lịch sử của coding agent)
# - *.db, *.sqlite (database local)
# - *.log (log files)
# - *.csv, *.xlsx (dữ liệu số)
